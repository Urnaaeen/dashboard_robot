{
  "openapi": "3.0.3",
  "info": {
    "title": "RPA Central Monitoring API",
    "version": "3.2.0",
    "description": "Authenticated PostgreSQL-backed API for robot inventory, machine heartbeat monitoring, latest runs, and Power Automate logging. Dashboard users are provisioned directly in the database; public registration is not available."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "security": [{ "cookieAuth": [] }],
  "tags": [
    { "name": "Authentication", "description": "Database-backed dashboard sign in and session management" },
    { "name": "Dashboard", "description": "Monitoring dashboard data" },
    { "name": "History", "description": "Searchable robot run history" },
    { "name": "Robots", "description": "Robot master inventory" },
    { "name": "Machines", "description": "Machine heartbeat and live availability" },
    { "name": "Logging", "description": "Power Automate run logging" }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign in with a database-provisioned account",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in and HttpOnly session cookie set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Delete the current session",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Signed out",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OkResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the signed-in user",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Current session user",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Check API and PostgreSQL connectivity",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "API and database are available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get robots, active machines, and latest runs",
        "description": "Returns all rpa_robot rows so turned-off robots remain visible, active rpa_machine rows, the latest rpa_robot_run for each robot, and events for those runs.",
        "operationId": "getDashboard",
        "responses": {
          "200": {
            "description": "Dashboard data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/history": {
      "get": {
        "tags": ["History"],
        "summary": "Search robot run history",
        "description": "Returns newest-first run records joined with robot display information.",
        "operationId": "getRunHistory",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Robot name/code, run ID, machine, input reference, or error text",
            "schema": { "type": "string", "maxLength": 200 }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "oneOf": [
                { "$ref": "#/components/schemas/RunStatus" },
                { "type": "string", "enum": ["ALL"] }
              ],
              "default": "ALL"
            }
          },
          {
            "name": "startedFrom",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "startedTo",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 200 }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered run history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunHistoryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/robots": {
      "post": {
        "tags": ["Robots"],
        "summary": "Create a robot with an automatic code",
        "description": "Creates a robot and assigns the next unique RPA-000001 style code on the server. Account Name and AnyDesk ID are display metadata only; no passwords are accepted.",
        "operationId": "createRobot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RobotCreateRequest" },
              "example": {
                "robotName": "ITZONE Receipt Bot",
                "robotType": "CLOUD_DESKTOP",
                "powerAutomateEnvironmentId": "Default-xxxxxxxx",
                "cloudFlowId": "xxxxxxxx",
                "cloudFlowName": "ITZONE Receipt Main Flow",
                "cloudFlowUrl": "https://make.powerautomate.com/manage/environments/Default-xxxxxxxx/flows/xxxxxxxx/details",
                "desktopFlowId": "xxxxxxxx",
                "desktopFlowName": "ITZONE Receipt PAD",
                "desktopFlowUrl": "https://make.powerautomate.com/manage/environments/Default-xxxxxxxx/uiflows/xxxxxxxx/details",
                "accountName": "Robot Account 02",
                "machineName": "BOT-PC-02",
                "machineIp": "10.0.0.22",
                "anydeskId": "123 456 789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created or updated robot",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/robots/{robotId}/active": {
      "patch": {
        "tags": ["Robots"],
        "summary": "Turn a robot on or off",
        "description": "ADMIN only. Turned-off robots remain visible, but new logger START requests return 409 Conflict. Existing RUNNING records may still be completed.",
        "operationId": "updateRobotActive",
        "parameters": [
          {
            "name": "robotId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RobotActiveUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Robot availability updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/robots/{robotId}/power-automate": {
      "patch": {
        "tags": ["Robots"],
        "summary": "Update a robot's Power Automate links",
        "description": "ADMIN only. Stores separate Cloud Flow and Desktop Flow targets plus the account name shown to dashboard users.",
        "operationId": "updateRobotPowerAutomate",
        "parameters": [
          {
            "name": "robotId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RobotPowerAutomateUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Power Automate settings updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/machines": {
      "get": {
        "tags": ["Machines"],
        "summary": "List machines with calculated availability",
        "description": "Status reports machine availability only, derived purely from the heartbeat. NOT_CONNECTED means the heartbeat agent has never reported. OFFLINE means the last heartbeat is older than MACHINE_OFFLINE_SECONDS. ONLINE means a heartbeat arrived inside that window. Robot workload is reported separately through runningRunCount and staleRunningCount.",
        "operationId": "getMachines",
        "responses": {
          "200": {
            "description": "Machine status list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MachineListResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/machines/heartbeat": {
      "post": {
        "tags": ["Machines"],
        "summary": "Record a machine heartbeat",
        "description": "Creates the machine when needed and refreshes its IP, AnyDesk ID, metadata, and server-side heartbeat timestamp.",
        "operationId": "recordMachineHeartbeat",
        "security": [{ "cookieAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MachineHeartbeatRequest" },
              "example": {
                "machineName": "BOT-PC-02",
                "machineIp": "10.0.0.22",
                "anydeskId": "123 456 789",
                "metadata": {
                  "os": "Microsoft Windows NT 10.0.26100.0",
                  "agent": "powershell-heartbeat"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Heartbeat recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MachineResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/logger/start": {
      "post": {
        "tags": ["Logging"],
        "summary": "Create a RUNNING robot run",
        "operationId": "startRobotRun",
        "security": [{ "cookieAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoggerStartRequest" },
              "example": {
                "robotCode": "RPA-000001",
                "cloudFlowRunId": "flow-run-001",
                "machineName": "BOT-PC-02"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "RUNNING record created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/logger/success": {
      "post": {
        "tags": ["Logging"],
        "summary": "Complete a run as SUCCESS",
        "operationId": "completeRobotRun",
        "security": [{ "cookieAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoggerSuccessRequest" },
              "example": {
                "robotCode": "RPA-000001",
                "cloudFlowRunId": "flow-run-001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run updated to SUCCESS",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/logger/failed": {
      "post": {
        "tags": ["Logging"],
        "summary": "Complete a run as FAILED",
        "operationId": "failRobotRun",
        "security": [{ "cookieAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoggerFailedRequest" },
              "example": {
                "robotCode": "RPA-000001",
                "cloudFlowRunId": "flow-run-001",
                "errorCode": "EXCEL_LOCKED",
                "errorMessage": "Excel file is locked by another process",
                "errorStep": "Open Excel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run updated to FAILED",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/logger/event": {
      "post": {
        "tags": ["Logging"],
        "summary": "Append a run event",
        "operationId": "createRunEvent",
        "security": [{ "cookieAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunEventCreateRequest" },
              "example": {
                "robotRunId": "10000000-0000-4000-8000-000000000001",
                "eventType": "INFO",
                "stepName": "Open Excel",
                "message": "Excel application opened."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RunEventResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/runs/status": {
      "post": {
        "tags": ["Logging"],
        "summary": "Set a run status",
        "operationId": "updateRunStatus",
        "security": [{ "cookieAuth": [] }, { "apiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RunStatusUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run status updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RobotRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rpa_session",
        "description": "HttpOnly session cookie set by /api/auth/login. The browser sends it automatically."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RPA-API-Key",
        "description": "Optional deployment secret for Power Automate logging endpoints."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "NotFound": {
        "description": "Record not found",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Conflict": {
        "description": "Unique value conflict",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or credentials are invalid",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "Forbidden": {
        "description": "The signed-in user does not have the required role",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "TooManyRequests": {
        "description": "Sign-in rate limit exceeded",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      },
      "ServerError": {
        "description": "Unexpected server or database error",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
        }
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": ["ADMIN", "OPERATOR", "VIEWER"]
      },
      "User": {
        "type": "object",
        "required": ["userId", "username", "displayName", "role", "isActive"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "username": { "type": "string", "example": "admin" },
          "displayName": { "type": "string", "example": "Dashboard Admin" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "isActive": { "type": "boolean" },
          "lastLoginAt": { "type": "string", "format": "date-time", "nullable": true },
          "sessionExpiresAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "maxLength": 100 },
          "password": { "type": "string", "format": "password", "minLength": 12, "maxLength": 256, "writeOnly": true }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["user", "expiresAt"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["user"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "OkResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean", "example": true }
        }
      },
      "RobotType": {
        "type": "string",
        "enum": ["CLOUD_DESKTOP", "CLOUD_ONLY", "DESKTOP_ONLY"]
      },
      "RunStatus": {
        "type": "string",
        "enum": ["QUEUED", "RUNNING", "SUCCESS", "FAILED", "CANCELLED", "TIMEOUT", "UNKNOWN"]
      },
      "MachineStatus": {
        "type": "string",
        "enum": ["ONLINE", "OFFLINE", "NOT_CONNECTED"]
      },
      "EventType": {
        "type": "string",
        "enum": ["INFO", "WARNING", "ERROR"]
      },
      "Robot": {
        "type": "object",
        "required": [
          "robotId", "robotCode", "robotName", "robotType",
          "maxExpectedRunMinutes", "isActive", "createdAt", "updatedAt"
        ],
        "properties": {
          "robotId": { "type": "string", "format": "uuid" },
          "robotCode": { "type": "string", "example": "RPA-000001" },
          "robotName": { "type": "string", "example": "ITZONE Receipt Bot" },
          "robotType": { "$ref": "#/components/schemas/RobotType" },
          "powerAutomateEnvironmentId": { "type": "string", "nullable": true },
          "cloudFlowId": { "type": "string", "nullable": true },
          "cloudFlowName": { "type": "string", "nullable": true },
          "cloudTriggerName": { "type": "string", "nullable": true },
          "cloudFlowUrl": { "type": "string", "format": "uri", "nullable": true },
          "desktopFlowId": { "type": "string", "nullable": true },
          "desktopFlowName": { "type": "string", "nullable": true },
          "desktopFlowUrl": { "type": "string", "format": "uri", "nullable": true },
          "powerAutomateUrl": { "type": "string", "format": "uri", "nullable": true },
          "accountName": { "type": "string", "nullable": true, "example": "Robot Account 02" },
          "machineId": { "type": "string", "format": "uuid", "nullable": true },
          "machineName": { "type": "string", "nullable": true },
          "machineIp": { "type": "string", "nullable": true },
          "anydeskId": { "type": "string", "nullable": true },
          "maxExpectedRunMinutes": { "type": "integer", "minimum": 1, "example": 30 },
          "isActive": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Machine": {
        "type": "object",
        "required": [
          "machineId", "machineName", "status", "robotCount", "runningRunCount",
          "robotNames", "runningRobotNames", "isActive", "createdAt", "updatedAt"
        ],
        "properties": {
          "machineId": { "type": "string", "format": "uuid" },
          "machineName": { "type": "string", "maxLength": 150, "example": "BOT-PC-02" },
          "machineIp": { "type": "string", "nullable": true, "example": "10.0.0.22" },
          "anydeskId": { "type": "string", "nullable": true, "example": "123 456 789" },
          "status": { "$ref": "#/components/schemas/MachineStatus" },
          "lastHeartbeatAt": { "type": "string", "format": "date-time", "nullable": true },
          "heartbeatAgeSeconds": { "type": "integer", "nullable": true, "description": "Seconds since the last heartbeat, null when the agent has never reported." },
          "heartbeatMetadata": { "type": "object", "nullable": true, "additionalProperties": true },
          "robotCount": { "type": "integer", "minimum": 0 },
          "runningRunCount": { "type": "integer", "minimum": 0 },
          "staleRunningCount": { "type": "integer", "minimum": 0, "description": "Runs still marked RUNNING past the robot max_expected_run_minutes." },
          "robotNames": { "type": "array", "items": { "type": "string" } },
          "runningRobotNames": { "type": "array", "items": { "type": "string" } },
          "lastRunStartedAt": { "type": "string", "format": "date-time", "nullable": true },
          "isActive": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RobotRun": {
        "type": "object",
        "required": ["robotRunId", "robotId", "status", "startedAt", "retryCount", "createdAt", "updatedAt"],
        "properties": {
          "robotRunId": { "type": "string", "format": "uuid" },
          "robotId": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/RunStatus" },
          "startedAt": { "type": "string", "format": "date-time" },
          "endedAt": { "type": "string", "format": "date-time", "nullable": true },
          "durationSeconds": { "type": "integer", "nullable": true, "minimum": 0 },
          "cloudFlowRunId": { "type": "string", "nullable": true },
          "desktopFlowSessionId": { "type": "string", "nullable": true },
          "machineName": { "type": "string", "nullable": true },
          "errorCode": { "type": "string", "nullable": true },
          "errorMessage": { "type": "string", "nullable": true },
          "errorStep": { "type": "string", "nullable": true },
          "retryCount": { "type": "integer", "minimum": 0 },
          "retryOfRunId": { "type": "string", "format": "uuid", "nullable": true },
          "inputReference": {
            "type": "string",
            "nullable": true,
            "description": "Server-generated daily reference, for example invoice-batch-2026-08-25-001."
          },
          "metadata": { "type": "object", "nullable": true, "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RunEvent": {
        "type": "object",
        "required": ["runEventId", "robotRunId", "eventType", "createdAt"],
        "properties": {
          "runEventId": { "type": "string", "format": "uuid" },
          "robotRunId": { "type": "string", "format": "uuid" },
          "eventType": { "$ref": "#/components/schemas/EventType" },
          "stepName": { "type": "string", "nullable": true },
          "message": { "type": "string", "nullable": true },
          "eventData": { "type": "object", "nullable": true, "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["ok", "generatedAt"],
        "properties": {
          "ok": { "type": "boolean", "example": true },
          "generatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "DashboardResponse": {
        "type": "object",
        "required": ["generatedAt", "robots", "robotRuns", "runEvents", "machines"],
        "properties": {
          "generatedAt": { "type": "string", "format": "date-time" },
          "machineOfflineSeconds": { "type": "integer", "description": "Seconds without a heartbeat before a machine is reported OFFLINE.", "example": 180 },
          "robots": { "type": "array", "items": { "$ref": "#/components/schemas/Robot" } },
          "robotRuns": { "type": "array", "items": { "$ref": "#/components/schemas/RobotRun" } },
          "runEvents": { "type": "array", "items": { "$ref": "#/components/schemas/RunEvent" } },
          "machines": { "type": "array", "items": { "$ref": "#/components/schemas/Machine" } }
        }
      },
      "MachineListResponse": {
        "type": "object",
        "required": ["generatedAt", "machineOfflineSeconds", "machines"],
        "properties": {
          "generatedAt": { "type": "string", "format": "date-time" },
          "machineOfflineSeconds": { "type": "integer", "description": "Seconds without a heartbeat before a machine is reported OFFLINE.", "example": 180 },
          "machines": { "type": "array", "items": { "$ref": "#/components/schemas/Machine" } }
        }
      },
      "RunHistoryItem": {
        "allOf": [
          { "$ref": "#/components/schemas/RobotRun" },
          {
            "type": "object",
            "required": ["robotCode", "robotName", "maxExpectedRunMinutes"],
            "properties": {
              "robotCode": { "type": "string" },
              "robotName": { "type": "string" },
              "accountName": { "type": "string", "nullable": true },
              "powerAutomateEnvironmentId": { "type": "string", "nullable": true },
              "powerAutomateUrl": { "type": "string", "format": "uri", "nullable": true },
              "maxExpectedRunMinutes": { "type": "integer", "minimum": 1 }
            }
          }
        ]
      },
      "RunHistoryResponse": {
        "type": "object",
        "required": ["generatedAt", "runs", "total", "limit"],
        "properties": {
          "generatedAt": { "type": "string", "format": "date-time" },
          "runs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RunHistoryItem" }
          },
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
        }
      },
      "RobotCreateRequest": {
        "type": "object",
        "required": ["robotName", "powerAutomateEnvironmentId", "machineName"],
        "properties": {
          "robotName": { "type": "string", "maxLength": 255 },
          "robotType": { "$ref": "#/components/schemas/RobotType" },
          "powerAutomateEnvironmentId": { "type": "string", "maxLength": 200 },
          "cloudFlowId": { "type": "string", "maxLength": 200 },
          "cloudFlowName": { "type": "string", "maxLength": 255 },
          "cloudTriggerName": { "type": "string", "maxLength": 150 },
          "cloudFlowUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
          "desktopFlowId": { "type": "string", "maxLength": 200 },
          "desktopFlowName": { "type": "string", "maxLength": 255 },
          "desktopFlowUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
          "powerAutomateUrl": { "type": "string", "format": "uri" },
          "accountName": { "type": "string", "maxLength": 150 },
          "machineName": { "type": "string", "maxLength": 150 },
          "machineIp": { "type": "string", "maxLength": 100 },
          "anydeskId": { "type": "string", "maxLength": 100 },
          "isActive": { "type": "boolean", "default": true }
        }
      },
      "RobotActiveUpdateRequest": {
        "type": "object",
        "required": ["isActive"],
        "properties": {
          "isActive": { "type": "boolean" }
        }
      },
      "RobotPowerAutomateUpdateRequest": {
        "type": "object",
        "properties": {
          "powerAutomateEnvironmentId": { "type": "string", "maxLength": 200 },
          "accountName": { "type": "string", "maxLength": 150 },
          "cloudFlowId": { "type": "string", "maxLength": 200 },
          "cloudFlowName": { "type": "string", "maxLength": 255 },
          "cloudFlowUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
          "desktopFlowId": { "type": "string", "maxLength": 200 },
          "desktopFlowName": { "type": "string", "maxLength": 255 },
          "desktopFlowUrl": { "type": "string", "format": "uri", "maxLength": 2000 }
        }
      },
      "MachineHeartbeatRequest": {
        "type": "object",
        "required": ["machineName"],
        "properties": {
          "machineName": { "type": "string", "minLength": 1, "maxLength": 150 },
          "machineIp": { "type": "string", "maxLength": 100 },
          "anydeskId": { "type": "string", "maxLength": 100 },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "LoggerStartRequest": {
        "type": "object",
        "required": ["robotCode"],
        "properties": {
          "robotCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Unique code assigned by the server when the robot is created."
          },
          "robotRunId": { "type": "string", "format": "uuid" },
          "startedAt": { "type": "string", "format": "date-time" },
          "cloudFlowRunId": {
            "type": "string",
            "description": "External identifier of the Power Automate cloud flow run."
          },
          "desktopFlowSessionId": { "type": "string" },
          "machineName": { "type": "string" },
          "retryCount": { "type": "integer", "minimum": 0, "default": 0 },
          "retryOfRunId": { "type": "string", "format": "uuid" },
          "metadata": { "type": "object", "additionalProperties": true },
          "stepName": { "type": "string" },
          "message": { "type": "string" },
          "eventData": { "type": "object", "additionalProperties": true }
        }
      },
      "LoggerSuccessRequest": {
        "type": "object",
        "required": ["robotCode"],
        "properties": {
          "robotCode": { "type": "string", "minLength": 1, "maxLength": 100 },
          "cloudFlowRunId": {
            "type": "string",
            "description": "Optional when exactly one run is RUNNING; use it to disambiguate concurrent runs."
          },
          "endedAt": { "type": "string", "format": "date-time" },
          "stepName": { "type": "string" },
          "message": { "type": "string" },
          "eventData": { "type": "object", "additionalProperties": true }
        }
      },
      "LoggerFailedRequest": {
        "type": "object",
        "required": ["robotCode", "errorMessage"],
        "properties": {
          "robotCode": { "type": "string", "minLength": 1, "maxLength": 100 },
          "cloudFlowRunId": {
            "type": "string",
            "description": "Optional when exactly one run is RUNNING; use it to disambiguate concurrent runs."
          },
          "endedAt": { "type": "string", "format": "date-time" },
          "errorCode": { "type": "string" },
          "errorMessage": { "type": "string" },
          "errorStep": { "type": "string" },
          "eventData": { "type": "object", "additionalProperties": true }
        }
      },
      "RunEventCreateRequest": {
        "type": "object",
        "required": ["robotRunId", "eventType", "message"],
        "properties": {
          "robotRunId": { "type": "string", "format": "uuid" },
          "eventType": { "$ref": "#/components/schemas/EventType" },
          "stepName": { "type": "string" },
          "message": { "type": "string" },
          "eventData": { "type": "object", "additionalProperties": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "RunStatusUpdateRequest": {
        "type": "object",
        "required": ["robotRunId", "status"],
        "properties": {
          "robotRunId": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/RunStatus" },
          "endedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "errorCode": { "type": "string" },
          "errorMessage": { "type": "string" },
          "errorStep": { "type": "string" }
        }
      },
      "RobotResponse": {
        "type": "object",
        "required": ["robot"],
        "properties": { "robot": { "$ref": "#/components/schemas/Robot" } }
      },
      "MachineResponse": {
        "type": "object",
        "required": ["machine"],
        "properties": { "machine": { "$ref": "#/components/schemas/Machine" } }
      },
      "RobotRunResponse": {
        "type": "object",
        "required": ["robotRun"],
        "properties": { "robotRun": { "$ref": "#/components/schemas/RobotRun" } }
      },
      "RunEventResponse": {
        "type": "object",
        "required": ["runEvent"],
        "properties": { "runEvent": { "$ref": "#/components/schemas/RunEvent" } }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
